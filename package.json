{
  "name": "rbx-tools",
  "private": true,
  "version": "0.2.17",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-frontend.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "icons": "node scripts/ensure-icons.mjs",
    "desktop": "npm run icons && tauri dev",
    "desktop:build": "npm run icons && tauri build",
    "desktop:build:portable": "npm run icons && tauri build --no-bundle",
    "postdesktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-builds-to-onedrive.ps1",
    "test": "vitest run && node --test scripts/check-build-cache.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/press-start-2p": "^5.2.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
