{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RBX Tools",
  "version": "0.2.41",
  "identifier": "dev.rbxtools.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "RBX Tools", "width": 1130, "height": 860, "minWidth": 740, "minHeight": 680, "center": true, "backgroundColor": "#141719", "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --disable-extensions --disable-sync --disable-default-apps --disable-domain-reliability --disable-client-side-phishing-detection --no-first-run --no-default-browser-check --disable-gpu" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Small tools. Less friction. More game time.",
    "category": "Utility",
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "startMenuFolder": "RBX Tools" } }
  }
}
